{
  "name": "verbalist",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "npm run dev -w @verbalist/web",
    "build": "npm run build -w @verbalist/web",
    "lint": "npm run lint -w @verbalist/web",
    "typecheck": "npm run typecheck -w @verbalist/web",
    "test": "npm run test -w @verbalist/web && npm run test:db",
    "test:db": "node --test tests/database.test.mjs tests/phase2-database.test.mjs tests/phase3-database.test.mjs tests/phase4-database.test.mjs",
    "test:e2e": "npm run test:e2e -w @verbalist/web",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "db:new": "supabase migration new"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "prettier": "3.9.10",
    "supabase": "3.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
