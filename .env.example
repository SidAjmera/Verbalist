# Copy the frontend values to apps/web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-hosted-publishable-key
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Copy backend values to apps/api/.env. Never prefix secret keys with NEXT_PUBLIC_.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-hosted-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-service-role-or-hosted-secret-key
WEB_ORIGINS=["http://127.0.0.1:3000"]
ENVIRONMENT=development
ENABLE_MOCK_AI=false
# Operator-controlled OpenAI-compatible endpoints. Leave unset to disable.
LOCAL_AI_BASE_URL=
COMPATIBLE_AI_BASE_URL=
# Optional operator-managed WebRTC relay. Empty ICE lists support only direct connectivity.
STUN_URLS=[]
TURN_URLS=[]
# coturn use-auth-secret/static-auth-secret counterpart; backend secret only.
TURN_SHARED_SECRET=
RTC_RELAY_ONLY=false
