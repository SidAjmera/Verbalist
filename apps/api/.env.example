# Copy to .env. Keep this file's filled-in copy out of Git and chat.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend-only Supabase secret key, used for account deletion.
SUPABASE_SECRET_KEY=
WEB_ORIGINS=["http://127.0.0.1:3000"]
ENVIRONMENT=development
ENABLE_MOCK_AI=false
LOCAL_AI_BASE_URL=
COMPATIBLE_AI_BASE_URL=
# Optional, operator-managed WebRTC relay configuration.
STUN_URLS=[]
TURN_URLS=[]
TURN_SHARED_SECRET=
RTC_RELAY_ONLY=false
